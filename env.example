# Copy to .env, inspect/edit, then source .env in the server shell.
# Keep HOME unchanged; choose your own writable data directory here.
export LAB_DATA_ROOT="${HOME}/alignment-lab-data"
export HF_HOME="${LAB_DATA_ROOT}/huggingface"
export HF_HUB_DISABLE_TELEMETRY=1
export TOKENIZERS_PARALLELISM=false
export WANDB_DISABLED=true
# Select an allocated/free GPU in your shell, not in this shared template.
# Do not override a scheduler's CUDA_VISIBLE_DEVICES.
# No GitHub token, API key, or model credentials belong in this file.
